generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  pseudo    String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  credits   Int      @default(20)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  EMPLOYE
}
